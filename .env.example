# Copy to .env and fill in. Sandbox credentials only.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX_BUYER_EMAIL=
PAYPAL_SANDBOX_BUYER_PASSWORD=
PAYPAL_SANDBOX_MERCHANT_EMAIL=
# Optional: id of the webhook registered with `npm run webhook:register` (turns on live PayPal event sync)
PAYPAL_WEBHOOK_ID=
# Optional: Postgres connection string (Neon gives a pooled one: use that). Used when the app runs in production,
# so hosted data survives restarts. Local `npm run dev` keeps using ./data unless you set STORE=postgres.
DATABASE_URL=
CHANNEL3_API_KEY=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Optional: AG Studio licence key (free 45-day trial). Without it the Insights page shows a watermark.
AG_STUDIO=
# Optional: only if you later switch providers
ANTHROPIC_API_KEY=
RENDER_API_KEY=
GITHUB_REPO_NAME=
